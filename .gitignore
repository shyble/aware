/target
**/*.rs.bk
Cargo.lock

/docs

# Bench outputs: model checkpoints are regenerated by runs and stay out,
# but the report.json files and aggregated summaries are the evidence the
# papers cite -- those are tracked. (The !**/ line re-includes directories
# so git descends into them; files stay ignored unless re-included.)
/data/bench*/**
!/data/bench*/**/
!/data/bench*/**/report.json
!/data/bench*/benchmark_results.csv
!/data/bench*/benchmark_results.md

# Corpora and tokenizers (refetched via scripts/fetch_*.py)
/data/wikitext103/
/data/wikitext2/

# Training logs
training_*.log
training_*.csv

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
.local/

# Manuscripts and paper drafts stay out of the public repo while
# submissions are under double-anonymous review; back up privately.
tex/
papers/

# nohup
nohup.out

# LaTeX build artifacts
papers/build/
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.tex.bak
__pycache__/
*.pyc
